{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "c-bridge-workbook",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "c-bridge-workbook"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			// Mock Test Centre: users / sessions / mock_test_attempts / mock_test_entitlements.
			// Real production database, created via Cloudflare MCP; migrations 0001-0002 applied.
			"binding": "DB",
			"database_name": "c-bridge-mock-test-centre",
			"database_id": "c9378610-a233-4cd2-ab9b-f52071e696b5",
			"migrations_dir": "migrations"
		}
	]
}