{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "c-bridge-workbook",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "c-bridge-workbook"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			// Mock Test Centre: users / sessions / mock_test_attempts.
			// PLACEHOLDER database_id — replace after running:
			//   npx wrangler login
			//   npx wrangler d1 create c-bridge-mock-test-centre
			// then paste the real database_id below before deploying to production.
			"binding": "DB",
			"database_name": "c-bridge-mock-test-centre",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}